{
    "routes": [
        {
            "src": "/api/(cache|card|colors|generator|stats|themes|translations|whitelist)\\.php",
            "status": 404,
            "dest": "/404.html"
        },
        { "handle": "filesystem" },
        { "src": "/", "dest": "/api/index.php" }
    ],
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    }
}
